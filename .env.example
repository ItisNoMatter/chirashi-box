NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# `npx supabase status` の PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。`npx supabase status` の SECRET_KEY（クライアントに出さない）
SUPABASE_SECRET_KEY=
# 巡回・URL登録の User-Agent に載せる連絡先（URL かメールアドレス、0016）
CRAWLER_CONTACT=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
